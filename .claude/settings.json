{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -10)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(gbrain --version)",
      "Bash(gbrain search *)",
      "Bash(gbrain doctor *)",
      "Bash(claude mcp list)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)"
    ]
  }
}
